{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aragon.research.report/v1",
  "title": "Aragon Research Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "instrument",
    "asOf",
    "headline",
    "rating",
    "summary",
    "keyMetrics",
    "sections",
    "risks",
    "sources",
    "disclaimer"
  ],
  "properties": {
    "schema": {
      "const": "aragon.research.report/v1"
    },
    "provisional": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "instrument": {
      "$ref": "#/$defs/instrument"
    },
    "asOf": {
      "type": "string",
      "minLength": 10,
      "maxLength": 40
    },
    "headline": {
      "type": "string",
      "minLength": 4,
      "maxLength": 160
    },
    "rating": {
      "$ref": "#/$defs/rating"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600
    },
    "keyMetrics": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 4,
      "maxLength": 300
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "name",
        "market",
        "currency"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "market": {
          "enum": [
            "CN",
            "HK",
            "US"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        }
      }
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stance",
        "conviction",
        "horizon"
      ],
      "properties": {
        "stance": {
          "enum": [
            "buy",
            "hold",
            "sell",
            "watch"
          ]
        },
        "conviction": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "horizon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "targetPrice": {
          "type": [
            "number",
            "null"
          ]
        },
        "upsidePct": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "deltaPct": {
          "type": [
            "number",
            "null"
          ]
        },
        "tone": {
          "enum": [
            "pos",
            "neg",
            "neutral",
            null
          ]
        },
        "sourceRefs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "severity",
        "trigger"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mitigant": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "sourceRefs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "publishedAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 24
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "retrievedAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 24
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "blocks": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "bulletItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "sourceRefs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "align": {
          "enum": [
            "left",
            "right",
            "center",
            null
          ]
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "data"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "data": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "timelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "title"
      ],
      "properties": {
        "date": {
          "type": "string",
          "minLength": 8,
          "maxLength": 24
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600
        },
        "sourceRefs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "symbol"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "pe": {
          "type": [
            "number",
            "null"
          ]
        },
        "pb": {
          "type": [
            "number",
            "null"
          ]
        },
        "growthPct": {
          "type": [
            "number",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "targetPrice",
        "probability",
        "assumptions"
      ],
      "properties": {
        "name": {
          "enum": [
            "bear",
            "base",
            "bull"
          ]
        },
        "targetPrice": {
          "type": "number"
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "assumptions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "block": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "enum": [
                "paragraph"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "level",
            "text"
          ],
          "properties": {
            "type": {
              "enum": [
                "heading"
              ]
            },
            "level": {
              "enum": [
                2,
                3,
                4
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "enum": [
                "bullets"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/bulletItem"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tone",
            "title",
            "text"
          ],
          "properties": {
            "type": {
              "enum": [
                "callout"
              ]
            },
            "tone": {
              "enum": [
                "info",
                "warn",
                "insight"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "enum": [
                "metrics"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/metric"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "columns",
            "rows"
          ],
          "properties": {
            "type": {
              "enum": [
                "table"
              ]
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/column"
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 80,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                },
                "maxProperties": 12
              }
            },
            "caption": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "chart"
          ],
          "properties": {
            "type": {
              "enum": [
                "chart"
              ]
            },
            "chart": {
              "$ref": "#/$defs/chartPayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "attribution",
            "sourceRefs"
          ],
          "properties": {
            "type": {
              "enum": [
                "quote"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "attribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "sourceRefs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "events"
          ],
          "properties": {
            "type": {
              "enum": [
                "timeline"
              ]
            },
            "events": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/timelineEvent"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "peers"
          ],
          "properties": {
            "type": {
              "enum": [
                "comparables"
              ]
            },
            "peers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/peer"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "scenarios"
          ],
          "properties": {
            "type": {
              "enum": [
                "scenario"
              ]
            },
            "scenarios": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/scenario"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "divider"
              ]
            }
          }
        }
      ]
    },
    "chartAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "category",
            "time",
            "value"
          ]
        },
        "labels": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 200,
          "items": {
            "type": "string",
            "maxLength": 32
          }
        }
      }
    },
    "chartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "xAxis",
        "series"
      ],
      "properties": {
        "kind": {
          "enum": [
            "line",
            "bar",
            "area",
            "scatter",
            "waterfall"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/series"
          }
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "xAxis": {
          "$ref": "#/$defs/chartAxis"
        }
      }
    }
  }
}
