# ============================================================================
# Aragon Research Terminal — environment
# Copy to `.env` (repo root). EVERY variable below has a working default:
# with this file absent the app still starts in mock/degraded mode.
# ============================================================================

# ── API ─────────────────────────────────────────────────────────────────────
PY_API_PORT=8000
# SQLite by default; swap for postgresql+psycopg://… if you want Postgres.
DATABASE_URL=sqlite:///api/data/app.db
# Cookie sessions + CORS: explicit origins only. `*` is refused at startup (credentials and
# a wildcard cannot be combined). Same-origin production (nginx) leaves this EMPTY.
ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional SERVICE credential for scripts (deploy/remote/*.sh, cron, curl) -- NOT a site
# password. Since v15 it no longer gates the whole API: people sign in with accounts
# (see "Users & permissions" below). A request carrying `Authorization: Bearer <token>`
# acts as the `service` principal: it may trigger generation, curate reports, read the
# audit log and the overview, but it can NOT manage users, quotas, invites, settings or
# the monthly budget (spec 24.3.4). A wrong/missing Bearer is simply treated as a visitor.
# SSE cannot send headers, so it uses the short-lived ?token= from
# POST /api/v1/runs/{id}/events-token (HMAC-signed with SESSION_SECRET).
# Anyone who knows this value is an administrator-lite: keep it server-side only.
API_TOKEN=
# ⚠ DEPRECATED AND DANGEROUS: NEXT_PUBLIC_API_TOKEN. Variables with the NEXT_PUBLIC_ prefix are
# compiled into the browser bundle, so setting it publishes API_TOKEN to every visitor. The
# front end no longer reads it (AC-206) -- do NOT define it. If an earlier build ever shipped
# with it set, treat API_TOKEN as leaked and rotate it before going live.

# ── Users & permissions (v15, spec 24.6.4) ─────────────────────────────────
# enforced = real accounts (default). open = the OLD behaviour: every request is the
# all-powerful `service` principal. open exists for local demos and the test-suite; the API
# logs an ERROR banner at start-up and it must never face anyone else.
AUTH_MODE=enforced
# The root administrator is created ONCE, when the database has no root yet.
ROOT_ADMIN_USERNAME=jdqqjr
# ⚠ ONLY READ AT FIRST BOOTSTRAP. Once a root exists, changing this does NOTHING (otherwise
# anyone who can edit this file could silently take over root). To change root's password
# later: sign in and use the account page, or on the server run
#   python -m app.cli reset-root-password
# The value below is the published initial password; with AUTH_FORCE_ROOT_PASSWORD_CHANGE=1
# the first sign-in is forced to pick a new one before anything else works.
ROOT_ADMIN_PASSWORD=13519126390
# 1 = a root that still has the default password must change it at first login (strongly
# recommended). 0 shows a non-dismissable red banner instead.
AUTH_FORCE_ROOT_PASSWORD_CHANGE=1
# HMAC key for SSE tokens. Empty = generated on first start and stored in the database
# (survives restarts). Set it if you ever run restore-from-backup onto a new database.
SESSION_SECRET=
# Session cookie `Secure` flag: auto (https or trusted-proxy https) | 1 | 0.
# Production behind nginx: set 1. Plain http on localhost: leave auto (a Secure cookie over
# http is silently dropped by the browser: "login succeeds, then logged out at once").
COOKIE_SECURE=auto
# 1 = trust X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host from the reverse proxy.
# MUST be 1 behind nginx (the systemd unit sets it): with 0, every visitor looks like
# 127.0.0.1 and shares ONE login/registration rate-limit bucket. Never 1 when the API is
# directly reachable from the internet (the header could be forged).
TRUST_PROXY=0
# The calendar day that daily generation quotas reset on.
QUOTA_TZ=Asia/Shanghai
# At most N live sessions per user (the oldest is signed out beyond that).
AUTH_MAX_SESSIONS_PER_USER=10
# "Remember me" sessions: absolute lifetime / idle timeout in days. Without "remember" a
# session is a browser-session cookie and expires server-side after 12 hours.
AUTH_SESSION_ABS_DAYS=30
AUTH_SESSION_IDLE_DAYS=7
# Dead sessions (revoked / idle-expired) are kept this many days, then swept (live ones never).
AUTH_SESSION_RETAIN_DAYS=30
# Self-service password recovery with a one-time recovery key (no email/SMS channel).
# Initial value only: the admin "system settings" page overrides it at runtime. root is excluded.
AUTH_RECOVERY_ENABLED=1
# 0 = switch the in-process rate limiters off. Tests only.
RATE_LIMIT_ENABLED=1
# Audit-log retention. Rows older than this are purged by the daily sweep.
AUDIT_RETENTION_DAYS=365
# 1 = mount GET /api/v1/auth/_test/captcha-answer (hands out captcha answers!). e2e only;
# it does not exist unless this is 1. NEVER set it on a reachable host.
AUTH_TEST_HOOKS=0

# ── Agent engine ────────────────────────────────────────────────────────────
# auto  = use aragon only when preflight says it is fully capable, else mock
# real  = require aragon, fail loudly (503 structured_result_unsupported)
# mock  = never touch the network; deterministic report from the snapshot
AGENT_MODE=auto
# 1 = ignore the 60s capability cache and re-run `aragon info --json`
FORCE_PREFLIGHT=0
# Baseline allow list. Intersected with `aragon info --json` -> tools at runtime.
# submit_result MUST stay: with --permission-mode strict it is the only channel
# through which a --result-schema can ever be satisfied.
ARAGON_REQUIRED_TOOLS=read_file,glob,grep,list_dir,submit_result
# Empty => resolved with shutil.which("aragon"). Point at an absolute path (or a
# fake script) to override.
ARAGON_BIN=
# Empty => use whatever provider/model the CLI is configured with.
ARAGON_PROVIDER=
ARAGON_MODEL=
# ── Third-party OpenAI-compatible endpoint (v9 K1 / spec §21.3.2) ───────────
# Measured (E-72/E-73): the CLI does NOT honour OPENAI_BASE_URL / OPENAI_API_KEY,
# so these two values can only travel as argv (--base-url / --api-key).
# Empty => use whatever the CLI's own profile says (v8 behaviour, unchanged).
# Point at /v1 or the root; trailing slash is trimmed; /chat/completions is rejected.
ARAGON_BASE_URL=
# The key appears only in the child's command line: argv.json is written redacted
# (***) and it never reaches logs, reports or the database. When this is set you
# no longer need OPENAI_API_KEY / DEEPSEEK_API_KEY (E-73: they are not honoured;
# keeping them just hands one more plaintext copy to the child's environment).
ARAGON_API_KEY=
# TTL for one engine self-check (seconds): a verified, unexpired probe is not
# re-spawned (one probe ~= $0.0016 / 10 s, measured E-86).
AGENT_PROBE_TTL_SEC=300
# 0 = disable POST /agent/probe (503 probe_disabled).
AGENT_PROBE_ENABLED=1
# Runner-level total attempts (1 = never retry). With retry authority taken back
# from the CLI this is the only place that retries, and only for
# provider_unavailable / result_missing (never auth / cancelled / budget / schema).
AGENT_ATTEMPTS=2
ARAGON_MAX_TURNS=40
ARAGON_MAX_DURATION_MS=900000
ARAGON_IDLE_TIMEOUT_MS=180000
ARAGON_TOOL_TIMEOUT_MS=60000
ARAGON_HOME=
# Extra env var NAMES to hand to the CLI subprocess, comma separated.
# The base list is minimal on purpose; this is the sanctioned door.
ARAGON_ENV_PASSTHROUGH=
# Warn (never block) when a known cost exceeds this. Ignored when cost is unknown.
MAX_REPORT_COST_USD=0.60

# ── Agent robustness (v7 / spec §20.3) ─────────────────────────────────────
# lean = inject --no-update --no-skills --no-gene --no-memory --no-todo --no-team
#        (measured: -2551 input tokens per turn, +76%, and a clean stderr)
# full = keep this machine's own posture (the one-line rollback, AC-68)
ARAGON_AGENT_POSTURE=lean
# Retries after the first attempt. The CLI default is 10 with up to 30s backoff,
# which can eat ARAGON_MAX_DURATION_MS and turn "network down" into "too slow".
ARAGON_RETRY_MAX=6
# Output token cap. "auto" (the CLI default) means "the model's ceiling", which
# makes truncation unpredictable; measured max output here is 34586.
ARAGON_MAX_OUTPUT_TOKENS=40000
# --result-repair-turns; clamped by `info.result.maxRepairTurns` (2) at spawn.
ARAGON_REPAIR_TURNS=2
# prompt.md + system.md + schema.json must stay under this (default 32 KiB).
ARAGON_MAX_PROMPT_BYTES=32768
# 0 = skip `aragon doctor` + `aragon models` (warn-only checks; measured 11.1s).
ARAGON_SELF_CHECK=1
# JSON price override for estimates, e.g.
# {"deepseek-flash":{"in":0.00014,"out":0.00028}} — a restart, not a release.
ARAGON_PRICE_OVERRIDE=


# ── Market data ─────────────────────────────────────────────────────────────
DATA_PROVIDERS=akshare,yfinance,synthetic
# 1 = synthetic data is an acceptable last resort (offline demo, tests)
ALLOW_SYNTHETIC=1
BAR_CACHE_TTL_SEC=900
PROVIDER_TIMEOUT_SEC=10

# ── Storage / housekeeping ──────────────────────────────────────────────────
# Workspace root for run artifacts. Defaults to api/workspace.
WORKSPACE_ROOT=
RUN_RETENTION_DAYS=14
# v14 (U5 / spec 23.3.5): trash window. Soft-deleted reports (user DELETE, or version
# trimming) are HARD deleted by report_service.purge_trash() after this many days --
# that is the project's only hard-delete entry point. 0 means 'delete on the next purge',
# which is for tests only (the whole point of a trash is those few days).
# NOTE: the hard delete also removes that version's ask history (report_asks.report_id
# is ON DELETE CASCADE), and leaves an orphan reference in cost_ledger (no FK there).
TRASH_RETENTION_DAYS=30

# ── 追问（A1）──────────────────────────────────────────────────────────────
# cite 档永不消耗额度（它不调模型）；deep 档按「单报告 24h」计数。
ASK_DAILY_LIMIT=30
ASK_DEEP_MAX_TURNS=12
ASK_DEEP_MAX_DURATION_MS=180000
ASK_MAX_QUESTION_CHARS=500
ASK_TOP_K=5

# ── 检索（A2）──────────────────────────────────────────────────────────────
# SEARCH_FTS=0 强制走 LIKE 兜底（无 FTS5 的构建会自动如此，无需手工设置）。
SEARCH_FTS=1
# auto = pypinyin 可 import 就启用；off = 关闭拼音维度（中文/代码/名称照常）。
SEARCH_PINYIN=auto

# ── 定时刷新（A4）──────────────────────────────────────────────────────────
SCHEDULER_ENABLED=1
SCHEDULER_TICK_SECONDS=30
SCHEDULER_LEASE_SECONDS=120
LOG_LEVEL=INFO

# ── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# 1 = proxy the API through Next (`/py/*`) so browser and API share an origin
ENABLE_PY_REWRITE=0
